<table class="table table-cv table-sm table-borderless table-responsive">
  <tbody>
    {% for item in entry.contents %}
      <tr>
        <td class="p-1 pr-2 font-weight-bold"><b>{{ item.name | escape }}</b></td>
        <td class="p-1 pl-2 font-weight-light text">{{ item.value | escape }}</td>
      </tr>
    {% endfor %}
  </tbody>
</table>
