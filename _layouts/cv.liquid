---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title | escape }}</h1>
    <p class="post-description">{{ page.description | escape }}</p>
  </header>
  <article>
    {{ content }}
    <div class="cv">
      {% for entry in site.data.cv %}
        <a class="anchor" id="{{ entry.title | escape }}"></a>
        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">{{ entry.title | escape }}</h3>
          <div>
            {% case entry.type %}
              {% when 'map' %}
                {% include cv/map.liquid %}
              {% when 'time_table' %}
                {% include cv/time_table.liquid %}
            {% endcase %}
          </div>
        </div>
      {% endfor %}
    </div>
  </article>
</div>
