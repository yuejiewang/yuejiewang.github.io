---
---
<div class="row">
  <div class="col col-sm-2 abbr"></div>
  <div id="{{ entry.key | escape }}" class="col-sm-8">
    <div class="title">{{ entry.title }}</div>
    <div class="author">
      {%- for author in entry.author_array -%}
        {%- unless forloop.first -%},&nbsp;{%- endunless -%}
        {%- if forloop.last and forloop.length > 1 -%}and&nbsp;{%- endif -%}
        {%- if site.scholar.last_name contains author.last and site.scholar.first_name contains author.first -%}
          <em>{{ author.first }} {{ author.last }}</em>
        {%- else -%}
          {{ author.first }} {{ author.last }}
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="periodical">{% if entry.journal %}<em>{{ entry.journal }}</em>{% elsif entry.booktitle %}<em>In {{ entry.booktitle }}</em> {% endif %}, {{ entry.year }}</div>
  </div>
</div>
