---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title"><span class="font-weight-bold">{{ site.first_name }}</span> {{ site.last_name }}</h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>
  <article>
    <div class="profile float-right">
      <figure>
        <img src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}" class="img-fluid z-depth-1 rounded" width="100%" height="auto" alt="{{ page.profile.image }}" loading="eager">
      </figure>
      <div class="more-info">{{ page.profile.more_info }}</div>
    </div>
    <div class="clearfix">{{ content }}</div>
  </article>
</div>
